{
  "name": "zubanum",
  "version": "2.3.0",
  "description": "Big-number library for growth loops: googol-scale towers, Knuth arrows, ordinal and named families such as TREE and SSCG, the composed -illion and -plex ladders, and exact ordering across every scale at once.",
  "main": "ZubaNum.js",
  "exports": {
    ".": "./ZubaNum.js",
    "./buza": "./buza.js"
  },
  "files": [
    "ZubaNum.js",
    "buza.js",
    "ZubaNum.luau",
    "buza.luau",
    "docs",
    "examples",
    "CHANGELOG.md"
  ],
  "scripts": {
    "quickstart": "node examples/quickstart.js",
    "ladder": "node examples/ladder_order.js",
    "tycoon": "node examples/tycoon_loop.js"
  },
  "keywords": [
    "big-number",
    "googology",
    "incremental-game",
    "hyperoperation",
    "knuth-arrow-notation",
    "ordinals",
    "tree-sscg",
    "roblox"
  ],
  "engines": {
    "node": ">=14"
  },
  "license": "SEE LICENSE IN LICENSE"
}
